    <!-- About & Licenses Dialogs -->
    <string name="str_about_html"><![CDATA[<h2>Mithril Firmware Scanner</h2><p>Advanced application for software content analysis: secrets detection, SBOM generation, CVE vulnerability auditing, open-source license identification, and kernel extraction powered by native <b>mithril</b> and <b>libarchive</b>.</p><p><b>Pipeline Workflow:</b><br/><code>moria -e firmware.bin &rarr; mithril firmware.bin.extracted/</code></p><hr/><b>Project License:</b> Apache 2.0<br/><b>Author:</b> Daniel Elias Diamon Vazquez<br/><b>GitHub:</b> <a href="https://github.com/Danielk10/mithril-firmware-scanner">mithril-firmware-scanner</a><br/><br/><b>Documentation:</b> README.md, docs/<br/>]]></string>

    <string name="licenses_dialog_title">Open Source Licenses</string>
